# Normalize text files to LF in the repository.
* text=auto

# Windows scripts must keep CRLF line endings in every checkout and in GitHub's "Download ZIP".
*.bat text eol=crlf
*.ps1 text eol=crlf

# Linux scripts must keep LF line endings, even when checked out on Windows.
*.sh text eol=lf
*.service text eol=lf
